# Copy this file to .env and fill in the values from your Supabase project
# (Settings -> API in the Supabase dashboard). Never put the service_role
# key here - only the anon/public key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
